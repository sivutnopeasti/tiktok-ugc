{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "instagram-profile-embed/profile",
  "version": "1.0.0",
  "title": "Instagram Profile Embed",
  "category": "embed",
  "icon": "instagram",
  "description": "Upottaa Instagram-käyttäjän profiilin.",
  "textdomain": "instagram-profile-embed",
  "attributes": {
    "username": {
      "type": "string",
      "default": ""
    },
    "height": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "editorScript": "ipe-block-editor"
}
